{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Precursor Config",
  "type": "object",
  "definitions": {
    "cursorName": {
      "type": "string",
      "pattern": "^[^\\s]*$"
    },
    "assetIndex": {
      "type": "integer",
      "description": "TODO",
      "minimum": 0
    },
    "frameAssets": {
      "type": "array",
      "description": "TODO",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/assetIndex"
          },
          {
            "type": "object",
            "required": ["index"],
            "properties": {
              "index": {
                "$ref": "#/definitions/assetIndex"
              },
              "scale": {
                "type": "integer",
                "description": "TODO",
                "default": 1,
                "minimum": 1
              }
            }
          }
        ]
      }
    }
  },
  "properties": {
    "theme": {
      "type": "object",
      "description": "Metadata for theme packages; required when packaging for Linux.",
      "required": [
        "name",
        "comment"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the theme."
        },
        "comment": {
          "type": "string",
          "description": "Short description of the theme."
        },
        "example": {
          "$ref": "#/definitions/cursorName",
          "description": "Specific cursor to be shown as an example in selection UIs.",
          "examples": [
            "arrow",
            "pointer"
          ]
        },
        "hidden": {
          "type": "boolean",
          "description": "Whether to hide this theme in selection UIs."
        },
        "locales": {
          "type": "object",
          "description": "Translations for various locales.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Localised name of the theme."
              },
              "comment": {
                "type": "string",
                "description": "Localised short description of the theme."
              }
            }
          }
        }
      }
    },
    "cursors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "assets"
        ],
        "properties": {
          "name": {
            "$ref": "#/definitions/cursorName",
            "description": "Name of the cursor."
          },
          "aliases": {
            "type": "array",
            "description": "Alternate names for the cursor.",
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/cursorName",
              "description": "Alternate name for the cursor."
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "nominal",
                "hotspot"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Path to the asset."
                },
                "nominal": {
                  "type": "integer",
                  "description": "Nominal size of the asset.",
                  "minimum": 0
                },
                "hotspot": {
                  "type": "array",
                  "description": "Coordinates that the asset should be centered on; the hotspot.",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "transforms": {
                  "type": "object",
                  "description": "Transformations to apply to the asset.",
                  "properties": {
                    "flip": {
                      "type": "boolean",
                      "description": "Flips the asset horizontally."
                    },
                    "flop": {
                      "type": "boolean",
                      "description": "Flips the asset vertically."
                    },
                    "rotate": {
                      "description": "Rotates the asset clockwise.",
                      "enum": [90, 180, 270]
                    }
                  }
                }
              }
            }
          },
          "frames": {
            "oneOf": [
              {
                "type": "array",
                "description": "Sequence of frames in the cursor.",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "description": "A frame in the cursor.",
                  "required": [
                    "duration",
                    "assets"
                  ],
                  "properties": {
                    "duration": {
                      "type": "integer",
                      "description": "Duration of this frame in milliseconds.",
                      "minimum": 1
                    },
                    "assets": {
                      "$ref": "#/definitions/frameAssets"
                    }
                  }
                }
              },
              {
                "type": "array",
                "description": "Sequence of frames in the cursor.",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "description": "A frame in the cursor.",
                  "required": [
                    "duration",
                    "assets"
                  ],
                  "properties": {
                    "duration": {
                      "type": "number",
                      "description": "Duration of this frame in milliseconds.\n\nWhen only a single frame has been defined, a cursor will be treated as static (non-animated). The duration of a frame in a static cursor is always `inf`.",
                      "minimum": 9999999999
                    },
                    "assets": {
                      "$ref": "#/definitions/frameAssets"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
