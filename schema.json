{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Precursor Config",
  "type": "object",
  "definitions": {
    "cursorName": {
      "type": "string",
      "pattern": "^[^\\s]*$"
    },
    "cursorAsset": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to the asset."
        },
        "nominal": {
          "type": "integer",
          "description": "Nominal size of the asset.",
          "minimum": 0
        },
        "hotspot": {
          "type": "array",
          "description":
            "Coordinates that the asset should be centered on: the hotspot.",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "type": "integer",
              "description": "The coordinate on the x-axis.",
              "minimum": 0
            },
            {
              "type": "integer",
              "description": "The coordinate on the y-axis.",
              "minimum": 0
            }
          ]
        },
        "transforms": {
          "type": "object",
          "description": "Transformations to apply to the asset.",
          "properties": {
            "flip": {
              "type": "boolean",
              "description": "Flips the asset horizontally."
            },
            "flop": {
              "type": "boolean",
              "description": "Flips the asset vertically."
            },
            "rotate": {
              "description": "Rotates the asset clockwise.",
              "enum": [0, 90, 180, 270]
            }
          }
        }
      },
      "required": [
        "path",
        "nominal",
        "hotspot"
      ]
    },
    "bitmapIndexInt": {
      "type": "integer",
      "description": "Position of an asset in the bitmap array, starting at 0.",
      "minimum": 0
    },
    "bitmapIndex": {
      "oneOf": [
        {
          "$ref": "#/definitions/bitmapIndexInt"
        },
        {
          "type": "object",
          "required": ["index"],
          "properties": {
            "index": {
              "$ref": "#/definitions/bitmapIndexInt"
            },
            "scale": {
              "type": "integer",
              "description": "Scale factor to apply to the asset.",
              "default": 1,
              "minimum": 1
            }
          }
        }
      ]
    },
    "bitmapIndexes": {
      "type": "array",
      "description": "Bitmap images to include in this frame.",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/bitmapIndex"
      }
    }
  },
  "properties": {
    "theme": {
      "type": "object",
      "description":
        "Metadata for theme packages; required when packaging for Linux.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the theme."
        },
        "comment": {
          "type": "string",
          "description": "Short description of the theme."
        },
        "example": {
          "$ref": "#/definitions/cursorName",
          "description":
            "Specific cursor to be shown as an example in selection UIs."
        },
        "hidden": {
          "type": "boolean",
          "description": "Whether to hide this theme in selection UIs."
        },
        "locales": {
          "type": "object",
          "description": "Translations for various locales.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Localised name of the theme."
              },
              "comment": {
                "type": "string",
                "description": "Localised short description of the theme."
              }
            }
          }
        }
      },
      "required": [
        "name",
        "comment"
      ]
    },
    "cursors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/definitions/cursorName",
            "description": "Name of the cursor."
          },
          "aliases": {
            "type": "array",
            "description": "Alternate names for the cursor.",
            "items": {
              "$ref": "#/definitions/cursorName",
              "description": "Alternate name for the cursor."
            },
            "uniqueItems": true
          },
          "bitmaps": {
            "type": "array",
            "description": "Bitmap images to include in the cursor.",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/cursorAsset"
            }
          },
          "frames": {
            "oneOf": [
              {
                "type": "array",
                "description": "Sequence of frames in the cursor.",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "description": "A frame in the cursor.",
                  "properties": {
                    "duration": {
                      "type": "number",
                      "description": "Duration of this frame in milliseconds.",
                      "minimum": 9999999999
                    },
                    "bitmaps": {
                      "$ref": "#/definitions/bitmapIndexes"
                    }
                  },
                  "required": [
                    "duration",
                    "bitmaps"
                  ]
                }
              },
              {
                "type": "array",
                "description": "Sequence of frames in the cursor.",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "description": "A frame in the cursor.",
                  "properties": {
                    "duration": {
                      "type": "integer",
                      "description": "Duration of this frame in milliseconds.",
                      "minimum": 1
                    },
                    "bitmaps": {
                      "$ref": "#/definitions/bitmapIndexes"
                    }
                  },
                  "required": [
                    "duration",
                    "bitmaps"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "name",
          "bitmaps"
        ]
      }
    }
  },
  "required": [
    "cursors"
  ]
}
